{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{name}}",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },
  // Fill in after `wrangler d1 create {{name}}` (placeholder id keeps `wrangler deploy --dry-run` working).
  "d1_databases": [{ "binding": "DB", "database_name": "{{name}}", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "durable_objects": { "bindings": [{ "name": "WORKSPACE_DO", "class_name": "WorkspaceDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  "observability": { "enabled": true }
}
