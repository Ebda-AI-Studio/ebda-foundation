# The launchd jobs that run on the Mac (Amendment A). Format: label-suffix <TAB> template path relative to os/. Everything else the old
# fleet scheduled is a brain cron/watcher or retired (decision per job in os/MANIFEST.md). Read by os/install.sh; the label is
# $OS_LAUNCHD_PREFIX.<label-suffix>.
ci-runner-guard	ops/launchd/com.ebda.os.ci-runner-guard.plist
guest-wedge-watch	ops/launchd/com.ebda.os.guest-wedge-watch.plist
hung-job-guard	ops/launchd/com.ebda.os.hung-job-guard.plist
mac-maintenance	ops/launchd/com.ebda.os.mac-maintenance.plist
workspace-hygiene	ops/launchd/com.ebda.os.workspace-hygiene.plist
usage-sentinel	ops/launchd/com.ebda.os.usage-sentinel.plist
graph-backfill	ops/launchd/com.ebda.os.graph-backfill.plist
instinct-extract	ops/launchd/com.ebda.os.instinct-extract.plist
session-mining	ops/launchd/com.ebda.os.session-mining.plist
claude-home-export	ops/launchd/com.ebda.os.claude-home-export.plist
ebda-cf-backup	ops/launchd/com.ebda.os.ebda-cf-backup.plist
os-selftest	ops/launchd/com.ebda.os.os-selftest.plist
hands-mac-local	cloud/hands/providers/launchd/com.ebda.os.hands-mac-local.plist
