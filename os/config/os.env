# Identity and paths for the AI OS layer. Sourced by os/ scripts; every value is overridable from the environment.
# No secrets here: credentials stay in OS_SERVICES_ENV, outside the repo.
OS_HOME="${OS_HOME:-$HOME/Desktop/projects/Ebda-AI-Studio/internal-projects/ebda-foundation}"
OS_REPO_SLUG="${OS_REPO_SLUG:-Ebda-AI-Studio/ebda-foundation}"
OS_ORGS="${OS_ORGS:-Ebda-AI-Studio Whisky-11 voidengineer-911}"
OS_LAUNCHD_PREFIX="${OS_LAUNCHD_PREFIX:-com.ebda.os}"
OS_GIT_CHAIN_KEY="${OS_GIT_CHAIN_KEY:-ebda.chainHusky}"
OS_STATE_DIR="${OS_STATE_DIR:-$HOME/.whisky-os-state}"
OS_SERVICES_ENV="${OS_SERVICES_ENV:-$HOME/.whisky-services.env}"
