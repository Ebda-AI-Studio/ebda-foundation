# Identity and paths for the AI OS layer. Sourced by os/ scripts through ops/lib/os-config.sh; every value is overridable from the environment
# or from ~/.ebda-os.local.env. No secrets here: credentials stay in OS_SERVICES_ENV, outside the repo.
# ops/lib/os-config.sh embeds the same defaults for hosts where this file is not found; os/tests/os-config-parity.test.sh keeps them equal.
OS_PROJECTS_DIR="${OS_PROJECTS_DIR:-$HOME/Desktop/projects}"
OS_HOME="${OS_HOME:-$OS_PROJECTS_DIR/Ebda-AI-Studio/internal-projects/ebda-foundation}"
OS_REPO_SLUG="${OS_REPO_SLUG:-Ebda-AI-Studio/ebda-foundation}"
OS_ORGS="${OS_ORGS:-Ebda-AI-Studio Whisky-11 voidengineer-911}"
OS_LAUNCHD_PREFIX="${OS_LAUNCHD_PREFIX:-com.ebda.os}"
OS_GIT_CHAIN_KEY="${OS_GIT_CHAIN_KEY:-ebda.chainHusky}"
OS_STATE_DIR="${OS_STATE_DIR:-$HOME/.whisky-os-state}"
OS_SERVICES_ENV="${OS_SERVICES_ENV:-$HOME/.whisky-services.env}"
# Sentry organisation the alert monitors read.
OS_SENTRY_ORG="${OS_SENTRY_ORG:-org-lingering-river-25973882}"
# Owner (personal GitHub account) of the personal repos.
OS_PERSONAL_OWNER="${OS_PERSONAL_OWNER:-voidengineer-911}"
# Business folders under OS_PROJECTS_DIR whose repos must not reference the predecessor (force-purge-check.sh).
OS_NONFORCE_BUSINESS_DIRS="${OS_NONFORCE_BUSINESS_DIRS:-Ebda-AI-Studio Whisky-11 Personal}"
