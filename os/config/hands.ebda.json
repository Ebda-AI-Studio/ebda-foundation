{
  "_comment": "The Ebda hands config (HANDS-COORD, 2026-11-10). Loaded as the brain var HANDS_CONFIG_JSON (deploy.sh renders it from this file; it holds no credential) and read by the ci-catchup watcher as the list of repos the OS watches. mergeGate is kept for the dormant merge path; the hands never run it while lib/policy.mjs HANDS_MAY_MERGE is false.",
  "jobCapMin": 45,
  "runCapMin": 90,
  "claudeModel": "sonnet",
  "maxTurns": 80,
  "usageThresholdPct": 80,
  "repos": {
    "Ebda-AI-Studio/ebda-store": {
      "defaultBranch": "main",
      "install": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npm",
        "test"
      ],
      "mergeGate": [
        "bash",
        "{os_home}/ops/merge-gate.sh",
        "{pr}",
        "{sha}",
        "--repo",
        "{repo}",
        "--workflows",
        "{base_workflows}"
      ],
      "protectedPaths": [
        ".github/**",
        "**/wrangler*.jsonc",
        "**/wrangler*.toml",
        "**/migrations/**"
      ]
    },
    "Ebda-AI-Studio/ebda-whatsapp": {
      "defaultBranch": "main",
      "install": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npm",
        "test"
      ],
      "mergeGate": [
        "bash",
        "{os_home}/ops/merge-gate.sh",
        "{pr}",
        "{sha}",
        "--repo",
        "{repo}",
        "--workflows",
        "{base_workflows}"
      ],
      "protectedPaths": [
        ".github/**",
        "**/wrangler*.jsonc",
        "**/migrations/**"
      ]
    },
    "Ebda-AI-Studio/ebda-foundation": {
      "defaultBranch": "main",
      "install": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npm",
        "test"
      ],
      "mergeGate": [
        "bash",
        "{os_home}/ops/merge-gate.sh",
        "{pr}",
        "{sha}",
        "--repo",
        "{repo}",
        "--workflows",
        "{base_workflows}"
      ],
      "protectedPaths": [
        "os/**",
        ".github/**"
      ]
    }
  }
}
