<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>Label</key>
	<string>com.ebda.os.fleet-dep-audit</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/scripts/fleet-dep-audit.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/ebda-os-fleet-dep-audit.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/ebda-os-fleet-dep-audit.log</string>
	<!-- Calendar, NOT StartInterval: ops/install.sh boots every job out and in on each run,
	     and a StartInterval timer restarts from that bootstrap without firing at load, so a
	     weekly interval never elapsed (runs=0, no log). A calendar slot survives re-bootstrap;
	     launchd runs a slot missed while asleep on wake. Mondays 06:30. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
